# App
NODE_ENV=development
PORT=3004
SERVICE_NAME=collect-service

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/ugc_collect_db?schema=public"

# JWT
JWT_ACCESS_SECRET=your_super_secret_access_key_change_in_production_min_64_chars

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Public widget token (pour les requêtes e-commerce sans auth JWT)
WIDGET_PUBLIC_SECRET=your_widget_public_secret_key